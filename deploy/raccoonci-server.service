# Raccoon CI server as a systemd service. See docs/deploy.md.
#
#   sudo install -m 0755 dist/raccoonci-server /usr/local/bin/
#   sudo install -m 0644 deploy/raccoonci-server.service /etc/systemd/system/
#   (make /etc/raccoonci/ as the guide says, then)
#   sudo systemctl daemon-reload && sudo systemctl enable --now raccoonci-server
#
# Secrets are systemd credentials: files that only root can read, handed to the
# service in a private directory (%d) as files readable by its user alone, which
# is what the server insists on for every NAME_FILE. They never appear in the
# environment, the command line or `systemctl show`.
#
# Do not use -local-runner under this unit: it runs jobs on the machine as the
# server's user with no isolation, which this unit's restrictions would break
# anyway and which is for development only.

[Unit]
Description=Raccoon CI server
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
DynamicUser=yes
# /var/lib/raccoonci-server: the database and what is kept on disk. It stays
# when the service stops and belongs to the service's (dynamic) user.
StateDirectory=raccoonci-server
StateDirectoryMode=0700
UMask=0077

# What is not secret: RACCOONCI_GITHUB_APP_ID, RACCOONCI_GITHUB_CLIENT_ID if
# used, and the command line's variable part as RACCOONCI_ARGS
# (-allow, -public-url, -snapshot, -listen... see raccoonci-server -h).
EnvironmentFile=/etc/raccoonci/server.env

LoadCredential=webhook-secret:/etc/raccoonci/webhook.secret
LoadCredential=api-token:/etc/raccoonci/api.token
LoadCredential=master-key:/etc/raccoonci/master.key
LoadCredential=github-app-key:/etc/raccoonci/app.pem
Environment=RACCOONCI_WEBHOOK_SECRET_FILE=%d/webhook-secret
Environment=RACCOONCI_API_TOKEN_FILE=%d/api-token
Environment=RACCOONCI_MASTER_KEY_FILE=%d/master-key
Environment=RACCOONCI_GITHUB_APP_KEY_FILE=%d/github-app-key
# More, as needed (each: a LoadCredential line and an Environment line):
#   INSTABOX_API_KEY_FILE            to run jobs on InstaBox
#   RACCOONCI_GITHUB_CLIENT_SECRET_FILE   to let people sign in with GitHub
#   RACCOONCI_STORAGE_S3_KEY_FILE, RACCOONCI_STORAGE_S3_SECRET_FILE   for -storage-s3-bucket

ExecStart=/usr/local/bin/raccoonci-server -data-dir %S/raccoonci-server -listen 127.0.0.1:18080 $RACCOONCI_ARGS

Restart=on-failure
RestartSec=5
# On SIGTERM the server cancels the runs in progress, deletes their machines and
# queues the runs again, which takes a while.
TimeoutStopSec=90
LimitNOFILE=65536

# What the server may do: talk to the network, write its state directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
